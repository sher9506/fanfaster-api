{"1":[[null,[[1,"1) 52-moddaning birinchi qismi"]]],["“Gumon qilinuvchi, ayblanuvchi yoki",[[2,"2) 91-modda:"]]],["“Quyidagi protsessual harakatlar videoyozuv",[[1,"1) oʻta ogʻir jinoyatlar"],[2,"2) tintuv;"],[3,"3) koʻrsatuvlarni hodisa sodir"],[4,"4) tergov eksperimenti;"],[5,"5) shaxsni ushlash;"],[6,"6) himoyachidan voz kechish;"],[7,"7) shaxsni ushlash jarayonida"]]],["“Ushbu modda toʻrtinchi qismining",[[3,"3) 217-moddaning matni quyidagi"]]],["“Surishtiruvchi, tergovchi, prokuror gumon",[]],["Ushlab turilgan, qamoqqa olingan,",[[4,"4) 224-moddaning matni quyidagi"]]],["“Ichki ishlar organi xodimi,",[[1,"1) oʻzini tanishtirishi va"],[2,"2) gumon qilinuvchiga u"],[3,"3) ushlab turilgan shaxsga"],[4,"4) ushlab turilgan shaxsga"],[5,"5) ushlab turilgan shaxsdan"]]],["Ushlanayotgan shaxsda qurol borligi",[]],["Ushbu moddaning birinchi va",[]],["Ushbu moddaning birinchi va ikkinchi qismlarida nazarda tutilgan protsessual harakatlarni",[]],["Shaxsni ushlash videoyozuv orqali",[]],["Shaxsni yalangʻochlash bilan bogʻliq",[]],["Ushlab turish, shaxsiy tintuv",[]],["Agar ushlangan shaxs ish",[]],["Vakolatli shaxslar va fuqarolar",[[5,"5) 225-moddaning birinchi qismi"]]],["“Ushlab turilgan shaxs ichki",[[1,"1) bayonnoma tuzilgan joy"],[2,"2) ushbu shaxsning kimligi,"],[3,"3) ushlangan shaxs qanday"],[4,"4) ushlangan shaxs ichki"],[5,"5) shaxsiy tintuv qilish"],[6,"6) ushlashning videoyozuv orqali"]]]],"2":[],"3":[]}